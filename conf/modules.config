/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'FALCO_RAW' {
        publishDir = [
            path: { "${params.outdir}/falco/${meta.id}/raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FALCO_AFTER_FASTP' {
        publishDir = [
            path: { "${params.outdir}/falco/${meta.id}/trimmed" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FALCO_AFTER_MERGE' {
        publishDir = [
            path: { "${params.outdir}/falco/${meta.id}/merge" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTP_TRIM' {
        ext.args = {
            [
                params.fastp_trim_min_length != null ? "-l ${params.fastp_trim_min_length}" : '',
                params.fastp_trim_poly_g_min_len != null ? "--poly_g_min_len ${params.fastp_trim_poly_g_min_len}" : '',
                params.fastp_trim_front1 != null ? "--trim_front1 ${params.fastp_trim_front1}" : '',
                params.fastp_trim_dedup ? '--dedup' : '',
                params.fastp_trim_cut_window_size != null ? "-W ${params.fastp_trim_cut_window_size}" : '',
                params.fastp_trim_cut_front ? '-5' : '',
                params.fastp_trim_cut_tail ? '-3' : '',
                params.fastp_trim_low_complexity_filter ? "--low_complexity_filter ${params.fastp_trim_complexity_threshold}" : '',
                params.fastp_extra_args ? "${params.fastp_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastp/trimmed/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTP_MERGE' {
        ext.args = {
            [
                params.fastp_merge_min_length != null ? "-l ${params.fastp_merge_min_length}" : '',
                params.fastp_merge_overlap_len_require != null ? "--overlap_len_require ${params.fastp_merge_overlap_len_require}" : '',
                params.fastp_merge_overlap_diff_limit != null ? "--overlap_diff_limit ${params.fastp_merge_overlap_diff_limit}" : '',
                params.fastp_extra_args ? "${params.fastp_extra_args}" : ''
            ].join(' ').trim()
        }
        ext.prefix = { "${meta.id}.merge" }
        publishDir = [
            path: { "${params.outdir}/fastp/merged/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEQKIT_STATS' {
        ext.args = '--all'  // add any extra arguments
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/reads_length/${meta.id}/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GETSEQKITK' {
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/reads_length/${meta.id}/seqkit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'KMERGENIE' {
        ext.args = {"-k ${params.kmergenie_largest_kmer} -l ${params.kmergenie_smallest_kmer}"}
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/kmergenie/${meta.id}/kmergenie" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GETKMERGENIEK' {
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/kmergenie/${meta.id}/kmergenie" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTK_FASTK' {
        ext.args = {
            [
                "-k${params.fastk_kmer}",
                params.fastk_t != null ? "-t${params.fastk_t}" : '',
                (params.fastk_profile_output == null || params.fastk_profile_output) ? '-p' : '',
                (params.fastk_verbose == null || params.fastk_verbose) ? '-v' : '',
                params.fastk_extra_args ? "${params.fastk_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastk/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTK_HISTEX' {
        ext.args = {
            [
                params.histex_g_output ? '-G' : '',
                params.histex_extra_args ? "${params.histex_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fastk/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GENESCOPEFK_P1' {
        ext.args = '-p 1 -k 17'
        publishDir = [
            path: { "${params.outdir}/genescopefk/${meta.id}/p1" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GENESCOPEFK_P2' {
        ext.args = '-p 2 -k 17'
        publishDir = [
            path: { "${params.outdir}/genescopefk/${meta.id}/p2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPADES_MANUAL' {
        ext.args = {
            [
                "-k ${params.spades_kmer_list}",
                params.spades_extra_args ? "${params.spades_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/manual/${meta.id}/spades" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPADES_KMERGENIE' {
        ext.args = {
            // Use the pre-computed kmer_list from metadata
            def kmer_arg = "-k ${meta.kmer_list_spades}"
            def extra = params.spades_extra_args ?: ""
            [kmer_arg, extra].findAll().join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/kmergenie/${meta.id}/spades" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPADES_READS_LENGTH' {
        ext.args = {
            // Use the pre-computed kmer_list from metadata
            def kmer_arg = "-k ${meta.kmer_list_spades}"
            def extra = params.spades_extra_args ?: ""
            [kmer_arg, extra].findAll().join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/reads_length/${meta.id}/spades" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MEGAHIT_MANUAL' {
        ext.args = {
            [
                "--k-list ${params.megahit_kmer_list}",
                params.megahit_extra_args ? "${params.megahit_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/manual/${meta.id}/megahit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MEGAHIT_KMERGENIE' {
        ext.args = {
            [
                "--k-list ${meta.kmer_list_megahit}",
                params.megahit_extra_args ? "${params.megahit_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/kmergenie/${meta.id}/megahit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MEGAHIT_READS_LENGTH' {
        ext.args = {
            [
                "--k-list ${meta.kmer_list_megahit}",
                params.megahit_extra_args ? "${params.megahit_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/reads_length/${meta.id}/megahit" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIA_MANUAL' {
        ext.args = {
            [
                "-kmer-size ${params.minia_kmer}",
                params.minia_extra_args ? "${params.minia_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/manual/${meta.id}/minia" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIA_KMERGENIE' {
        ext.args = {
            [
                "-kmer-size ${meta.single_kmer}",
                params.minia_extra_args ? "${params.minia_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/kmergenie/${meta.id}/minia" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIA_READS_LENGTH' {
        ext.args = {
            [
                "-kmer-size ${meta.single_kmer}",
                params.minia_extra_args ? "${params.minia_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/reads_length/${meta.id}/minia" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ABYSS_MANUAL' {
        ext.args = {
            [
                params.abyss_extra_args ? "${params.abyss_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/manual/${meta.id}/abyss" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ABYSS_KMERGENIE' {
        ext.args = {
            [
                params.abyss_extra_args ? "${params.abyss_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/kmergenie/${meta.id}/abyss" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ABYSS_READS_LENGTH' {
        ext.args = {
            [
                params.abyss_extra_args ? "${params.abyss_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/reads_length/${meta.id}/abyss" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPARSEASSEMBLER_MANUAL' {
        ext.args = {
            [
                params.sparseassembler_extra_args ? "${params.sparseassembler_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/manual/${meta.id}/sparseassembler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPARSEASSEMBLER_KMERGENIE' {
        ext.args = {
            [
                params.sparseassembler_extra_args ? "${params.sparseassembler_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/kmergenie/${meta.id}/sparseassembler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPARSEASSEMBLER_READS_LENGTH' {
        ext.args = {
            [
                params.sparseassembler_extra_args ? "${params.sparseassembler_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/reads_length/${meta.id}/sparseassembler" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RENAME_ASSEMBLIES' {
        publishDir = [
            path: { "${params.outdir}/assemblies/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUSCO_BUSCO' {
        ext.args = {
            [
                params.busco_extra_args ? "${params.busco_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/${meta.kmer_strategy}/${meta.id}/busco_general/${meta.assembler}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUSCO_SPECIFIC' {
        ext.args = {
            [
                params.busco_extra_args ? "${params.busco_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/${meta.kmer_strategy}/${meta.id}/busco_specific/${meta.assembler}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MERQURYFK_MERQURYFK' {
        publishDir = [
            path: { "${params.outdir}/${meta.reads_type}/${meta.kmer_strategy}/${meta.id}/merquryfk/${meta.assembler}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUAST' {
        ext.args = {
            [
                params.quast_extra_args ? "${params.quast_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/quast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SELECTBESTASSEMBLY' {
        publishDir = [
            path: { "${params.outdir}/best_assembly/${meta.id}/select_best_assembly" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PYPOLCA_RUN' {
        ext.args = {
            [
                params.pypolca_extra_args ? "${params.pypolca_extra_args}" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/best_assembly/${meta.id}/pypolca" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
